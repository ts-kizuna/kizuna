{
  "name": "@ts-kizuna-demo/kotlin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate": "node ../../packages/kotlin/dist/cli.mjs generate --contract ../shared/src/contract.ts --out kotlin/src/main/kotlin/com/kizuna/demo/APIClient.kt --namespace-name API --package com.kizuna.demo",
    "pretest": "pnpm generate",
    "test": "tsx scripts/test.ts",
    "build": "cd kotlin && ./gradlew build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ts-kizuna-demo/shared": "workspace:*",
    "@ts-kizuna/kotlin": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
