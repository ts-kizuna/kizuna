{
  "name": "@ts-kizuna-demo/express",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "kizuna deprecations ../shared/src/contract.ts && concurrently -n server,client -c cyan,magenta \"tsx watch src/index.ts\" \"sleep 1.5 && tsx src/scripts/run-client.ts\"",
    "server": "kizuna deprecations ../shared/src/contract.ts && tsx watch src/index.ts",
    "server:once": "kizuna deprecations ../shared/src/contract.ts && tsx src/index.ts",
    "client": "tsx src/scripts/run-client.ts",
    "typecheck": "tsc --noEmit",
    "openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@ts-kizuna-demo/shared": "workspace:*",
    "@ts-kizuna/contract": "workspace:*",
    "@ts-kizuna/fetch": "workspace:*",
    "@ts-kizuna/mcp": "workspace:*",
    "@ts-kizuna/openapi": "workspace:*",
    "@ts-kizuna/server": "workspace:*",
    "express": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ts-kizuna/cli": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
