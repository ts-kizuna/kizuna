{
  "name": "@ts-kizuna/ai",
  "version": "1.40.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.mts",
        "default": "./dist/runtime.mjs"
      },
      "require": {
        "types": "./dist/runtime.d.cts",
        "default": "./dist/runtime.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui.d.mts",
        "default": "./dist/ui.mjs"
      },
      "require": {
        "types": "./dist/ui.d.cts",
        "default": "./dist/ui.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/runtime.ts src/ui.ts --format esm,cjs --dts --clean --external @ts-kizuna/core --external zod --external ai",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ts-kizuna/core": "workspace:*",
    "ai": "^7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.0",
    "@ts-kizuna/core": "workspace:*",
    "ai": "^7.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
