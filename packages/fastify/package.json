{
  "name": "@ts-kizuna/fastify",
  "version": "1.53.0",
  "description": "Fastify adapter for ts-kizuna",
  "keywords": [
    "ts-kizuna",
    "typescript",
    "zod",
    "openapi",
    "contract-first",
    "type-safe",
    "rest",
    "api",
    "fastify",
    "adapter",
    "server"
  ],
  "license": "MIT",
  "homepage": "https://ts-kizuna.com/docs/adapters/fastify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ts-kizuna/kizuna.git",
    "directory": "packages/fastify"
  },
  "bugs": "https://github.com/ts-kizuna/kizuna/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "kizuna": {
    "entries": {
      ".": "server"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean --external @ts-kizuna/core --external fastify --external fastify-plugin --external zod",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify-plugin": "^5.1.0"
  },
  "peerDependencies": {
    "@ts-kizuna/core": "workspace:*",
    "fastify": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@ts-kizuna/core": "workspace:*",
    "fastify": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
