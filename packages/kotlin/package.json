{
  "name": "@ts-kizuna/kotlin",
  "version": "1.35.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "ts-kizuna-kotlin": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts --format esm,cjs --dts --clean --external @ts-kizuna/core --external @ts-kizuna/cli --external zod",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ts-kizuna/core": "workspace:*",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@ts-kizuna/cli": "workspace:*"
  },
  "devDependencies": {
    "@ts-kizuna/core": "workspace:*",
    "@types/node": "^22.9.0",
    "tsdown": "^0.21.0",
    "typescript": "^5.6.3",
    "zod": "^4.0.0"
  }
}
