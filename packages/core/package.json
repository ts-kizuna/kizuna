{
  "name": "@ts-kizuna/core",
  "version": "1.49.4",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas.d.mts",
        "default": "./dist/schemas.mjs"
      },
      "require": {
        "types": "./dist/schemas.d.cts",
        "default": "./dist/schemas.cjs"
      }
    },
    "./authoring-names": {
      "import": {
        "types": "./dist/authoring-names.d.mts",
        "default": "./dist/authoring-names.mjs"
      },
      "require": {
        "types": "./dist/authoring-names.d.cts",
        "default": "./dist/authoring-names.cjs"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.mts",
        "default": "./dist/plugin.mjs"
      },
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      }
    },
    "./load-deprecations": {
      "import": {
        "types": "./dist/load-deprecations.d.mts",
        "default": "./dist/load-deprecations.mjs"
      },
      "require": {
        "types": "./dist/load-deprecations.d.cts",
        "default": "./dist/load-deprecations.cjs"
      }
    },
    "./adapter": {
      "import": {
        "types": "./dist/adapter.d.mts",
        "default": "./dist/adapter.mjs"
      },
      "require": {
        "types": "./dist/adapter.d.cts",
        "default": "./dist/adapter.cjs"
      }
    },
    "./generator": {
      "import": {
        "types": "./dist/generator.d.mts",
        "default": "./dist/generator.mjs"
      },
      "require": {
        "types": "./dist/generator.d.cts",
        "default": "./dist/generator.cjs"
      }
    },
    "./jobs": {
      "import": {
        "types": "./dist/jobs-entry.d.mts",
        "default": "./dist/jobs-entry.mjs"
      },
      "require": {
        "types": "./dist/jobs-entry.d.cts",
        "default": "./dist/jobs-entry.cjs"
      }
    }
  },
  "kizuna": {
    "entries": {
      ".": "client",
      "./schemas": "client",
      "./authoring-names": "client",
      "./plugin": "client",
      "./generator": "client",
      "./adapter": "server",
      "./jobs": "server",
      "./load-deprecations": "server"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/**/*.fixture.ts",
    "!src/adapter-testing"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/adapter.ts src/jobs-entry.ts src/plugin.ts src/generator.ts src/schemas.ts src/authoring-names.ts src/load-deprecations.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:",
    "vitest": "3.2.4"
  }
}
