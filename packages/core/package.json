{
  "name": "@ts-kizuna/core",
  "version": "1.44.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas.d.mts",
        "default": "./dist/schemas.mjs"
      },
      "require": {
        "types": "./dist/schemas.d.cts",
        "default": "./dist/schemas.cjs"
      }
    },
    "./authoring-names": {
      "import": {
        "types": "./dist/authoring-names.d.mts",
        "default": "./dist/authoring-names.mjs"
      },
      "require": {
        "types": "./dist/authoring-names.d.cts",
        "default": "./dist/authoring-names.cjs"
      }
    },
    "./adapter": {
      "import": {
        "types": "./dist/adapter.d.mts",
        "default": "./dist/adapter.mjs"
      },
      "require": {
        "types": "./dist/adapter.d.cts",
        "default": "./dist/adapter.cjs"
      }
    },
    "./generator": {
      "import": {
        "types": "./dist/generator.d.mts",
        "default": "./dist/generator.mjs"
      },
      "require": {
        "types": "./dist/generator.d.cts",
        "default": "./dist/generator.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/**/*.fixture.ts",
    "!src/adapter-testing"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/adapter.ts src/generator.ts src/schemas.ts src/authoring-names.ts src/load-deprecations.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:",
    "vitest": "3.2.4"
  }
}
