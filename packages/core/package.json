{
  "name": "@ts-kizuna/core",
  "version": "1.53.0",
  "description": "Contract and route definition, validation, and the adapter API for ts-kizuna",
  "keywords": [
    "ts-kizuna",
    "typescript",
    "zod",
    "openapi",
    "contract-first",
    "type-safe",
    "rest",
    "api",
    "routes",
    "validation",
    "http"
  ],
  "license": "MIT",
  "homepage": "https://ts-kizuna.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ts-kizuna/kizuna.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/ts-kizuna/kizuna/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas.d.mts",
        "default": "./dist/schemas.mjs"
      },
      "require": {
        "types": "./dist/schemas.d.cts",
        "default": "./dist/schemas.cjs"
      }
    },
    "./authoring-names": {
      "import": {
        "types": "./dist/authoring-names.d.mts",
        "default": "./dist/authoring-names.mjs"
      },
      "require": {
        "types": "./dist/authoring-names.d.cts",
        "default": "./dist/authoring-names.cjs"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.mts",
        "default": "./dist/plugin.mjs"
      },
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      }
    },
    "./adapter": {
      "import": {
        "types": "./dist/adapter.d.mts",
        "default": "./dist/adapter.mjs"
      },
      "require": {
        "types": "./dist/adapter.d.cts",
        "default": "./dist/adapter.cjs"
      }
    },
    "./generator": {
      "import": {
        "types": "./dist/generator.d.mts",
        "default": "./dist/generator.mjs"
      },
      "require": {
        "types": "./dist/generator.d.cts",
        "default": "./dist/generator.cjs"
      }
    },
    "./jobs": {
      "import": {
        "types": "./dist/jobs-entry.d.mts",
        "default": "./dist/jobs-entry.mjs"
      },
      "require": {
        "types": "./dist/jobs-entry.d.cts",
        "default": "./dist/jobs-entry.cjs"
      }
    }
  },
  "kizuna": {
    "entries": {
      ".": "client",
      "./schemas": "client",
      "./authoring-names": "client",
      "./plugin": "client",
      "./generator": "client",
      "./adapter": "server",
      "./jobs": "server"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/**/*.fixture.ts",
    "!src/adapter-testing"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/adapter.ts src/jobs-entry.ts src/plugin.ts src/generator.ts src/schemas.ts src/authoring-names.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:",
    "vitest": "3.2.4"
  }
}
