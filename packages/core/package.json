{
  "name": "@ts-kizuna/core",
  "version": "1.10.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapter": {
      "import": {
        "types": "./dist/adapter.d.mts",
        "default": "./dist/adapter.mjs"
      },
      "require": {
        "types": "./dist/adapter.d.cts",
        "default": "./dist/adapter.cjs"
      }
    },
    "./generator": {
      "import": {
        "types": "./dist/generator.d.mts",
        "default": "./dist/generator.mjs"
      },
      "require": {
        "types": "./dist/generator.d.cts",
        "default": "./dist/generator.cjs"
      }
    },
    "./tsdown": {
      "import": {
        "types": "./dist/tsdown.d.mts",
        "default": "./dist/tsdown.mjs"
      },
      "require": {
        "types": "./dist/tsdown.d.cts",
        "default": "./dist/tsdown.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/adapter.ts src/generator.ts src/tsdown.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "tsdown": ">=0.20.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tsdown": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "tsdown": "^0.21.0",
    "zod": "^4.0.0"
  }
}
