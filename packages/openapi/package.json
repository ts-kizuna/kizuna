{
  "name": "@ts-kizuna/openapi",
  "version": "1.49.4",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    }
  },
  "kizuna": {
    "entries": {
      ".": "client",
      "./server": "server"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/server.ts --format esm,cjs --dts --clean --external @ts-kizuna/core --external zod",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ts-kizuna/core": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@ts-kizuna/core": "workspace:*",
    "@ts-kizuna/express": "workspace:*",
    "@types/express": "catalog:",
    "express": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "dependencies": {
    "yaml": "^2.8.4"
  }
}
