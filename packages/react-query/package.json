{
  "name": "@ts-kizuna/react-query",
  "version": "1.19.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean --external @ts-kizuna/core --external @ts-kizuna/fetch --external zod --external @tanstack/react-query --external react",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@ts-kizuna/core": "workspace:*",
    "@ts-kizuna/fetch": "workspace:*",
    "react": ">=18",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@testing-library/react": "^16.1.0",
    "@ts-kizuna/core": "workspace:*",
    "@ts-kizuna/fetch": "workspace:*",
    "@types/react": "^19.2.0",
    "jsdom": "^25.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsdown": "^0.21.0",
    "typescript": "^5.6.3",
    "zod": "^4.0.0"
  }
}
