{
  "name": "@ts-kizuna/payload",
  "version": "1.13.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean --external @ts-kizuna/core --external payload --external zod",
    "typecheck": "tsc --noEmit",
    "test:int": "vitest run --config dev/vitest.config.ts"
  },
  "peerDependencies": {
    "@ts-kizuna/core": "workspace:*",
    "payload": ">=3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@payloadcms/db-sqlite": "^3.84.0",
    "@ts-kizuna/core": "workspace:*",
    "payload": "^3.84.0",
    "tsdown": "^0.21.0",
    "typescript": "^5.6.3",
    "zod": "^4.0.0"
  }
}
