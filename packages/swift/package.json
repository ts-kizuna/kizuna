{
  "name": "@ts-kizuna/swift",
  "version": "1.49.7",
  "description": "Swift client generation for ts-kizuna contracts",
  "keywords": [
    "ts-kizuna",
    "typescript",
    "zod",
    "openapi",
    "contract-first",
    "type-safe",
    "rest",
    "api",
    "swift",
    "ios",
    "codegen",
    "client-generation"
  ],
  "license": "MIT",
  "homepage": "https://ts-kizuna.com/docs/clients/swift",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ts-kizuna/kizuna.git",
    "directory": "packages/swift"
  },
  "bugs": "https://github.com/ts-kizuna/kizuna/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "ts-kizuna-swift": "./dist/cli.mjs"
  },
  "kizuna": {
    "entries": {
      ".": "server"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts --format esm,cjs --dts --clean --external @ts-kizuna/shared --external @ts-kizuna/cli --external zod",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ts-kizuna/cli": "workspace:*",
    "@ts-kizuna/shared": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
