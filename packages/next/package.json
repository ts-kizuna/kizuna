{
  "name": "@ts-kizuna/next",
  "version": "1.51.0",
  "description": "Next.js App Router adapter for ts-kizuna",
  "keywords": [
    "ts-kizuna",
    "typescript",
    "zod",
    "openapi",
    "contract-first",
    "type-safe",
    "rest",
    "api",
    "nextjs",
    "next",
    "app-router",
    "adapter"
  ],
  "license": "MIT",
  "homepage": "https://ts-kizuna.com/docs/adapters/next",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ts-kizuna/kizuna.git",
    "directory": "packages/next"
  },
  "bugs": "https://github.com/ts-kizuna/kizuna/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.mts",
        "default": "./dist/config.mjs"
      },
      "require": {
        "types": "./dist/config.d.cts",
        "default": "./dist/config.cjs"
      }
    }
  },
  "kizuna": {
    "entries": {
      ".": "server",
      "./config": "server"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/config.ts --format esm,cjs --dts --clean --external @ts-kizuna/core --external zod",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ts-kizuna/core": "workspace:*",
    "next": ">=16.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@ts-kizuna/core": "workspace:*",
    "next": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
