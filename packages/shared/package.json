{
  "name": "@ts-kizuna/shared",
  "version": "1.49.7",
  "description": "Utilities shared by the ts-kizuna contract and server packages",
  "keywords": [
    "ts-kizuna",
    "typescript",
    "zod",
    "openapi",
    "contract-first",
    "type-safe",
    "rest",
    "api",
    "routes",
    "validation",
    "http"
  ],
  "license": "MIT",
  "homepage": "https://ts-kizuna.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ts-kizuna/kizuna.git",
    "directory": "packages/shared"
  },
  "bugs": "https://github.com/ts-kizuna/kizuna/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./generator": {
      "import": {
        "types": "./dist/generator.d.mts",
        "default": "./dist/generator.mjs"
      },
      "require": {
        "types": "./dist/generator.d.cts",
        "default": "./dist/generator.cjs"
      }
    },
    "./load-deprecations": {
      "import": {
        "types": "./dist/load-deprecations.d.mts",
        "default": "./dist/load-deprecations.mjs"
      },
      "require": {
        "types": "./dist/load-deprecations.d.cts",
        "default": "./dist/load-deprecations.cjs"
      }
    }
  },
  "kizuna": {
    "entries": {
      ".": "client",
      "./generator": "client",
      "./load-deprecations": "server"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/**/*.fixture.ts",
    "!src/adapter-testing"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/generator.ts src/load-deprecations.ts --format esm,cjs --dts --clean --external zod",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:",
    "vitest": "3.2.4"
  }
}
