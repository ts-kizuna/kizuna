{
  "name": "kizuna",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm build && concurrently -n express,next -c cyan,magenta \"pnpm --filter @ts-kizuna-demo/express dev\" \"pnpm --filter @ts-kizuna-demo/next dev\"",
    "build": "pnpm typecheck && pnpm -r --filter \"./packages/*\" build && pnpm generate:swift",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run && pnpm test:swift",
    "test:ts": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest --typecheck.only",
    "generate:swift": "pnpm --filter @ts-kizuna-demo/swift generate",
    "test:swift": "pnpm --filter @ts-kizuna-demo/swift test",
    "swift:build": "pnpm --filter @ts-kizuna-demo/swift build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docs": "pnpm --filter docs dev",
    "release": "release-it"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest-expect-openapi": "^6.0.1",
    "prettier": "^3.3.3",
    "release-it": "^20.0.1",
    "supertest": "^7.1.4",
    "tsdown": "^0.21.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.32.1"
}
